<UserControl x:Class="QRStudio.Presentation.Views.CreateQrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="36,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="CREADOR"
                   Style="{StaticResource EyebrowTextStyle}"
                   Foreground="{StaticResource CyanAccentBrush}" />
        <TextBlock Text="Diseña tu código QR"
                   Margin="0,6,0,0"
                   Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Configura el contenido, la apariencia y la resistencia de lectura."
                   Margin="0,8,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Width="112"
              Height="40"
              Style="{StaticResource SecondaryButtonStyle}"
              Command="{Binding ResetFormCommand}"
              Content="↻  Limpiar" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,26,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="0.95*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="1. Contenido"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Text="Define qué ocurrirá al escanear el código."
                         Margin="0,5,0,20"
                         FontSize="12"
                         Foreground="{StaticResource MutedTextBrush}" />

              <TextBlock Text="Tipo de QR" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox ItemsSource="{Binding ContentTypes}"
                        SelectedItem="{Binding SelectedContentType}"
                        DisplayMemberPath="DisplayName" />

              <TextBlock Text="Nombre del diseño"
                         Margin="0,18,0,8"
                         Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Ejemplo: Wi-Fi oficina o Portafolio" />

              <TextBlock Text="{Binding SelectedContentType.PrimaryLabel}"
                         Margin="0,18,0,8"
                         Style="{StaticResource FieldLabelStyle}" />
              <TextBox MinHeight="76"
                       Height="Auto"
                       Padding="13,11"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalContentAlignment="Top"
                       Text="{Binding PrimaryValue, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding SelectedContentType.PrimaryPlaceholder}" />

              <StackPanel Margin="0,18,0,0"
                          Visibility="{Binding ShowSecondaryValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SelectedContentType.SecondaryLabel}"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox MinHeight="66"
                         Height="Auto"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Text="{Binding SecondaryValue, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SelectedContentType.SecondaryPlaceholder}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,18,0,0"
                  Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="2. Apariencia"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Text="Usa alto contraste para conservar una lectura confiable."
                         Margin="0,5,0,20"
                         FontSize="12"
                         Foreground="{StaticResource MutedTextBrush}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <TextBlock Text="Color del código" Style="{StaticResource FieldLabelStyle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="44"
                            CornerRadius="7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             Text="{Binding ForegroundHex, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#071225"
                            Command="{Binding ApplyForegroundPresetCommand}"
                            CommandParameter="#071225" />
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#075985"
                            Command="{Binding ApplyForegroundPresetCommand}"
                            CommandParameter="#075985" />
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#5B21B6"
                            Command="{Binding ApplyForegroundPresetCommand}"
                            CommandParameter="#5B21B6" />
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#111827"
                            Command="{Binding ApplyForegroundPresetCommand}"
                            CommandParameter="#111827" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Color de fondo" Style="{StaticResource FieldLabelStyle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32"
                            Height="44"
                            CornerRadius="7"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             Text="{Binding BackgroundHex, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#FFFFFF"
                            Command="{Binding ApplyBackgroundPresetCommand}"
                            CommandParameter="#FFFFFF" />
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#ECFEFF"
                            Command="{Binding ApplyBackgroundPresetCommand}"
                            CommandParameter="#ECFEFF" />
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#F5F3FF"
                            Command="{Binding ApplyBackgroundPresetCommand}"
                            CommandParameter="#F5F3FF" />
                    <Button Style="{StaticResource ColorPresetButtonStyle}"
                            Background="#FFF7ED"
                            Command="{Binding ApplyBackgroundPresetCommand}"
                            CommandParameter="#FFF7ED" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Escala"
                             Style="{StaticResource FieldLabelStyle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="3"
                            Maximum="30"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PixelsPerModule}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PixelsPerModule}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource CyanAccentBrush}"
                               FontWeight="SemiBold" />
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Corrección de errores"
                             Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding ErrorCorrectionLevels}"
                            SelectedItem="{Binding SelectedErrorCorrection}"
                            DisplayMemberPath="DisplayName" />
                </StackPanel>
              </Grid>

              <CheckBox Margin="0,20,0,0"
                        IsChecked="{Binding IncludeQuietZone}"
                        Content="Incluir zona de seguridad alrededor del código" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2"
              Style="{StaticResource CardBorderStyle}"
              Padding="28">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="Vista previa"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="La imagen final se exportará en formato PNG."
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>

          <Border Grid.Row="1"
                  Margin="0,24"
                  MinHeight="340"
                  CornerRadius="18"
                  Background="#F8FAFC"
                  BorderBrush="#2B3D5A"
                  BorderThickness="1">
            <Grid Margin="26">
              <Image Source="{Binding PreviewImage}"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="NearestNeighbor"
                     Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasPreview, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Border Width="104"
                        Height="104"
                        CornerRadius="22"
                        Background="#E8EEF7">
                  <Viewbox Margin="24">
                    <Grid Width="48" Height="48">
                      <Rectangle Width="15" Height="15"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Stroke="#32415A"
                                 StrokeThickness="5" />
                      <Rectangle Width="15" Height="15"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Stroke="#32415A"
                                 StrokeThickness="5" />
                      <Rectangle Width="15" Height="15"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Stroke="#32415A"
                                 StrokeThickness="5" />
                      <Rectangle Width="10" Height="10"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Fill="#58708F" />
                    </Grid>
                  </Viewbox>
                </Border>
                <TextBlock Text="Tu código aparecerá aquí"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#32415A"
                           FontWeight="SemiBold" />
                <TextBlock Text="Completa el contenido y pulsa Generar"
                           Margin="0,6,0,0"
                           Foreground="#718198"
                           FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2"
                  Margin="0,0,0,16"
                  Padding="13,11"
                  CornerRadius="10"
                  Background="#111E31">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsError}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Height="48"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding GenerateCommand}"
                    Content="✦  Generar QR" />
            <Button Grid.Column="2"
                    Height="48"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ExportCommand}"
                    Content="⇩  Exportar PNG" />
          </Grid>
        </Grid>
      </Border>

      <ProgressBar Grid.ColumnSpan="3"
                   Height="3"
                   Margin="0,-3,0,0"
                   VerticalAlignment="Top"
                   IsIndeterminate="True"
                   Foreground="{StaticResource CyanAccentBrush}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>

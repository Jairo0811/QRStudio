<UserControl x:Class="QRStudio.Presentation.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="36,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="PROYECTO"
                   Style="{StaticResource EyebrowTextStyle}"
                   Foreground="{StaticResource CyanAccentBrush}" />
        <TextBlock Text="Acerca de QR Studio"
                   Margin="0,6,0,0"
                   Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Una reconstrucción profesional de GeneradorQR."
                   Margin="0,8,0,0"
                   Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,28,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.85*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
          <Image Source="/Assets/qr-studio-branding.png"
                 Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Crea · Personaliza · Comparte"
                         FontSize="20"
                         FontWeight="SemiBold" />
              <TextBlock Margin="0,14,0,0"
                         TextWrapping="Wrap"
                         LineHeight="22"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="QR Studio convierte una antigua tarea académica en una aplicación moderna para crear, personalizar, exportar y administrar códigos QR desde Windows." />

              <Border Margin="0,22,0,0"
                      Padding="16"
                      CornerRadius="12"
                      Background="#111E31">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Versión" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding Version}"
                               Margin="0,5,0,0"
                               FontSize="16"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="PLATAFORMA" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Windows · x64"
                               Margin="0,5,0,0"
                               FontSize="16"
                               FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border Margin="0,18,0,0"
                  Style="{StaticResource CardBorderStyle}">
            <StackPanel>
              <TextBlock Text="Tecnologías"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Margin="0,12,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text=".NET 10 · C# · WPF · MVVM · QRCoder · xUnit" />
              <TextBlock Margin="0,22,0,0"
                         Text="Autor"
                         Style="{StaticResource EyebrowTextStyle}" />
              <TextBlock Margin="0,6,0,0"
                         Text="Jairo Matías"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <TextBlock Margin="0,3,0,0"
                         Text="Desarrollador de software · República Dominicana"
                         Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>

<Window x:Class="QRStudio.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Studio"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="24,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <Border Width="44"
                  Height="44"
                  CornerRadius="12"
                  Background="{StaticResource AccentGradientBrush}">
            <Viewbox Margin="10">
              <Grid Width="24" Height="24">
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Stroke="White" StrokeThickness="3" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Stroke="White" StrokeThickness="3" />
                <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Stroke="White" StrokeThickness="3" />
                <Rectangle Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Fill="White" />
              </Grid>
            </Viewbox>
          </Border>
          <StackPanel Margin="12,1,0,0">
            <TextBlock Text="QR STUDIO"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White" />
            <TextBlock Text="Crea · Personaliza · Comparte"
                       Margin="0,3,0,0"
                       FontSize="10"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,42,0,0">
          <TextBlock Text="ESPACIO DE TRABAJO"
                     Margin="12,0,0,10"
                     Style="{StaticResource EyebrowTextStyle}" />
          <Button Style="{StaticResource NavigationButtonStyle}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="create">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✦" FontSize="16" Width="28" />
              <TextBlock Text="Crear QR" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavigationButtonStyle}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="history">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="◷" FontSize="17" Width="28" />
              <TextBlock Text="Historial" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NavigationButtonStyle}"
                  IsEnabled="False">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⌗" FontSize="17" Width="28" />
                <TextBlock Text="Lector QR" />
              </StackPanel>
              <Border Grid.Column="1"
                      Padding="7,3"
                      CornerRadius="7"
                      Background="#292142">
                <TextBlock Text="PRÓXIMO"
                           FontSize="8"
                           FontWeight="Bold"
                           Foreground="{StaticResource PurpleAccentBrush}" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="3">
          <Button Style="{StaticResource NavigationButtonStyle}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="about">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="ⓘ" FontSize="16" Width="28" />
              <TextBlock Text="Acerca de" />
            </StackPanel>
          </Button>
          <Border Margin="0,14,0,0"
                  Padding="14"
                  CornerRadius="12"
                  Background="#101A2C">
            <StackPanel>
              <TextBlock Text="{Binding Version, StringFormat=QR Studio v{0}}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PrimaryTextBrush}" />
              <TextBlock Text=".NET 10 · WPF · MVVM"
                         Margin="0,4,0,0"
                         FontSize="11"
                         Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Column="1"
                    Content="{Binding CurrentPage}" />
  </Grid>
</Window>
